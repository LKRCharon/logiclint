{
  "name": "logiclint",
  "version": "0.4.1",
  "private": true,
  "description": "Logic checks for AI-generated text, plans, and technical documents.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "logiclint": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/logiclint.mjs",
    "evaluate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/evaluate-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  }
}
